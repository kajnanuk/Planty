@model Aplikacja.Models.Wymaganie

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Wymaganie</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="RoslinaId" class="control-label"></label>
                <select asp-for="RoslinaId" class="form-control" asp-items="ViewBag.RoslinaId"></select>
                <span asp-validation-for="RoslinaId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Naslonecznienie" class="control-label"></label>
                <input asp-for="Naslonecznienie" class="form-control" />
                <span asp-validation-for="Naslonecznienie" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RodzajGleby" class="control-label"></label>
                <input asp-for="RodzajGleby" class="form-control" />
                <span asp-validation-for="RodzajGleby" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ZapotrzebowanieNaWode" class="control-label"></label>
                <input asp-for="ZapotrzebowanieNaWode" class="form-control" />
                <span asp-validation-for="ZapotrzebowanieNaWode" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Mrozoodpornosc" /> @Html.DisplayNameFor(model => model.Mrozoodpornosc)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
