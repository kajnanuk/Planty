@model IEnumerable<Aplikacja.Models.Wymaganie>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Roslina)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Naslonecznienie)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RodzajGleby)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ZapotrzebowanieNaWode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Mrozoodpornosc)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Roslina.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Naslonecznienie)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RodzajGleby)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ZapotrzebowanieNaWode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Mrozoodpornosc)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
